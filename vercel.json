{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/fair", "destination": "/index" },
    { "source": "/event", "destination": "/index" }
  ],
  "headers": [
    {
      "source": "/fair",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/event",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}